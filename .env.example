# Copy to .env.local for local runs. For GitHub Pages, add the same names as
# repository *Variables* (Settings > Secrets and variables > Actions > Variables).
# These web-app values are public by design; Firestore rules are what protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Optional: Google OAuth client id, enables importing PDFs from Google Drive folders (see DEPLOY.md).
VITE_GOOGLE_CLIENT_ID=
