rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only people whose email has a document in /allow/<email> can read or write the business data.
    // Create those documents by hand in the Firebase console; clients can never write them.
    function allowed() {
      return request.auth != null
        && exists(/databases/$(database)/documents/allow/$(request.auth.token.email));
    }
    match /rec/{id} {
      allow read: if allowed();
      allow create, update: if allowed()
        && request.resource.data.keys().hasOnly(['rev', 'data', 'by', 'at'])
        && request.resource.data.rev is int
        && (request.resource.data.data == null || request.resource.data.data is string);
      allow delete: if false;
    }
    // Big businesses are stored in pieces (see src/lib/firebase.js); same access rule as /rec.
    match /recparts/{id} {
      allow read: if allowed();
      allow create, update: if allowed()
        && request.resource.data.keys().hasOnly(['rev', 'data', 'at'])
        && request.resource.data.rev is int
        && request.resource.data.data is string;
      allow delete: if false;
    }
    // Shop-floor people sign in to the Process Scan phone app with their own accounts, listed in /scanallow/<email>
    // (created by hand in the Firebase console, like /allow). Each document has one field, `biz`: the business id
    // that person may scan for (shown in the main app under Process scan). They can add scans for that business only,
    // read the little the phone needs (/scanmeta/<that biz>), and see their own scans. They can never read or write the business data.
    function scanner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/scanallow/$(request.auth.token.email))
        && get(/databases/$(database)/documents/scanallow/$(request.auth.token.email)).data.biz is string;
    }
    function scannerBiz() {
      return get(/databases/$(database)/documents/scanallow/$(request.auth.token.email)).data.biz;
    }
    // Shop-floor scans from the Process Scan phone app. A phone may only append a "waiting" scan in its own name;
    // the main app marks it applied or rejected. Scans are never deleted.
    match /scans/{id} {
      allow read: if allowed() || (scanner() && resource.data.by == request.auth.token.email);
      allow create: if (allowed() || (scanner() && request.resource.data.biz == scannerBiz()))
        && request.resource.data.keys().hasOnly(['biz', 'data', 'status', 'by', 'at'])
        && request.resource.data.status == 'waiting'
        && request.resource.data.by == request.auth.token.email
        && request.resource.data.biz is string
        && request.resource.data.data is string
        && request.resource.data.data.size() < 5000;
      allow update: if allowed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'done']);
      allow delete: if false;
    }
    // What the main app tells the phone: vendors, open stacking lots, the approval switch.
    match /scanmeta/{id} {
      allow read: if allowed() || (scanner() && id == scannerBiz());
      allow create, update: if allowed()
        && request.resource.data.keys().hasOnly(['data', 'at'])
        && request.resource.data.data is string;
      allow delete: if false;
    }
    match /scanallow/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }
    match /allow/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }
  }
}
